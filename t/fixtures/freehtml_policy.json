{
  "css": [
    [".panel{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}", true],
    [".panel{--accent:#10b981;color:var(--accent);box-shadow:0 2px 8px #000;backdrop-filter:blur(4px)}", true],
    [".panel:hover:has(img){filter:drop-shadow(0 4px 4px #000);transition:transform .2s;transform:translateX(5px)}", true],
    [".panel > [data-value^=\"-\"]{color:red}.panel[data-state=\"on\"]{opacity:1}", true],
    ["@media (max-width:800px){.panel{display:flex;flex-wrap:wrap}}", true],
    ["@supports (display:grid){.panel{display:grid}}", true],
    ["@container (min-width:400px){.panel{grid-template-columns:1fr 1fr}}", true],
    ["@keyframes flow{0%{stroke-dashoffset:20}100%{stroke-dashoffset:0}}.flow{animation:flow 1s linear infinite}", true],
